# Copia in .env (non versionato). Nessun segreto reale in questo file.
POSTGRES_USER=prospectlens
POSTGRES_PASSWORD=cambia-questa-password
POSTGRES_DB=prospectlens
POSTGRES_HOST_PORT=5433

# dev | demo
APP_MODE=dev

# Chiave API-Football (Fase 2). Lasciala vuota per usare solo i dati mock.
API_FOOTBALL_KEY=

# Dati reali (database <POSTGRES_DB>_real). Piano di import eseguito ogni giorno dal worker:
# competizioni (ID API, vedi docs/data-coverage.md) e stagione (anno di inizio).
# Ordine: Serie C (3 gironi) e Serie B, dalla stagione più recente. Con il piano Free
# (100 richieste/giorno) serve circa una settimana per completarlo.
API_IMPORT_PLAN="138,942,943:2024;136:2024;138,942,943:2023;136:2023;138,942,943:2022;136:2022"
API_DAILY_BUDGET=95
PIPELINE_HOUR=5
